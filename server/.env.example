PORT=5000
# Local development example. For Atlas, replace this with the Atlas URI for your own cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/devsync
# Startup performs up to three bounded connection attempts; no URI is written to logs.
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
# Optional private file storage directory; defaults to server/uploads.
# DEVSYNC_UPLOAD_DIRECTORY=D:/DevSync/private-uploads
# Per-file upload size limit in bytes (default 5242880 = 5 MB; max 50 MB).
# Optional integrations; configure real values only in the server environment.
# GITHUB_WEBHOOK_SECRET=
